// Valid: control flow with if/else, while, for
int main() {
    int x = 10;
    if (x > 5) {
        cout << "big" << endl;
    } else {
        cout << "small" << endl;
    }
    int sum = 0;
    while (sum < 100) {
        sum += x;
    }
    for (int i = 0; i < 5; i++) {
        cout << i << endl;
    }
    return 0;
}
