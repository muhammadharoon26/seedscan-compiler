// Example: Fibonacci sequence — tests functions, loops, I/O, arrays
int fibonacci(int n) {
    if (n <= 1) {
        return n;
    }
    int a = 0;
    int b = 1;
    int temp;
    for (int i = 2; i <= n; i++) {
        temp = a + b;
        a = b;
        b = temp;
    }
    return b;
}

int main() {
    int n = 10;
    cout << "Fibonacci sequence:" << endl;
    for (int i = 0; i < n; i++) {
        int result = fibonacci(i);
        cout << result << endl;
    }
    return 0;
}
