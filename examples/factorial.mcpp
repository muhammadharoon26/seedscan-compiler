// Example: Factorial with recursion
int factorial(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

int main() {
    int num;
    cout << "Enter a number: " << endl;
    cin >> num;
    int result = factorial(num);
    cout << "Factorial: " << result << endl;
    return 0;
}
